<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>

<VBox xmlns="http://javafx.com/javafx/25.0.2"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="polynome.menu_operations.MenuOperationsController"
      spacing="15">

    <padding>
        <Insets top="20" right="30" bottom="30" left="30"/>
    </padding>

    <Label text="Opérations sur les polynômes" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <VBox style="-fx-background-color: #eee; -fx-padding: 10; -fx-background-radius: 5;">
        <Label text="Polynôme P(x) actuel :" style="-fx-font-size: 12px; -fx-text-fill: #555;"/>
        <Label fx:id="labelPolynome" text="" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
    </VBox>

    <VBox spacing="5">
        <Label text="Saisie pour l'opération (Polynôme Q(x) ou nombre x) :" style="-fx-font-weight: bold;"/>
        <TextField fx:id="champSaisieOperation" promptText="ex: 3x^2 - 1  OU  ex pour évaluation: 2.5"/>
    </VBox>

    <HBox spacing="10">
        <Button text="Dérivée P'(x)" onAction="#deriver" prefWidth="120"/>
        <Button text="Primitive ∫P(x)" onAction="#primitive" prefWidth="120"/>
    </HBox>
    
    <HBox spacing="10">
        <Button text="Addition P(x) + Q(x)" onAction="#addition" prefWidth="150"/>
        <Button text="Multiplication P(x) * Q(x)" onAction="#multiplication" prefWidth="150"/>
    </HBox>

    <HBox spacing="10">
        <Button text="Évaluer en x" onAction="#evaluation" prefWidth="150"/>
        <Button text="Retour" onAction="#retour" prefWidth="150" style="-fx-base: #bdc3c7;"/>
    </HBox>

    <VBox style="-fx-background-color: #dff0d8; -fx-padding: 10; -fx-background-radius: 5;">
        <Label text="Résultat de la dernière opération :" style="-fx-font-size: 12px; -fx-text-fill: #3c763d;"/>
        <Label fx:id="labelResultat" text="Aucune opération effectuée" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2b542c;" wrapText="true"/>
    </VBox>

</VBox>