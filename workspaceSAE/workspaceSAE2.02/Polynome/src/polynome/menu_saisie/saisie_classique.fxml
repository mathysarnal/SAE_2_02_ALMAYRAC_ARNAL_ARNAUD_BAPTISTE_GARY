<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>

<VBox xmlns="http://javafx.com/javafx/25.0.2"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="polynome.menu_saisie.SaisieClassiqueController"
      spacing="20">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Saisie classique d'un polynôme" style="-fx-font-size: 18px;"/>

    <HBox spacing="10">
        <Label text="Degré :"/>
        <TextField fx:id="champDegre" promptText="ex: 3"/>
    </HBox>

    <Label text="Coefficients (du plus haut degré au constant)"/>
    <TextField fx:id="champCoefficients" promptText="ex: 2 -5 0 7"/>

    <Button text="Valider" onAction="#valider"/>
    <Button text="Retour" onAction="#retour"/>

</VBox>